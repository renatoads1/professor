@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar @(menuRecolhido ? "sidebar-recolhida" : null)">
        <NavMenu MenuRecolhido="menuRecolhido" MenuRecolhidoChanged="AtualizarEstadoMenu" />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool menuRecolhido;

    private void AtualizarEstadoMenu(bool recolhido) => menuRecolhido = recolhido;
}
