@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        @if (!MenuRecolhido)
        {
            <a class="navbar-brand" href="">professor</a>
        }
        <button title="Alternar menu" class="navbar-toggler mobile-menu-toggle" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <button type="button" class="btn btn-sm btn-outline-light menu-collapse-toggle"
                title="@(MenuRecolhido ? "Expandir menu" : "Recolher menu")"
                aria-label="@(MenuRecolhido ? "Expandir menu" : "Recolher menu")"
                @onclick="ToggleSidebar">
            <span class="bi @(MenuRecolhido ? "bi-chevron-right" : "bi-chevron-left")" aria-hidden="true"></span>
            @if (!MenuRecolhido)
            {
                <span>Recolher</span>
            }
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                @if (!MenuRecolhido) { <span>Home</span> }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login">
                <svg class="nav-menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 4h6v16h-6" />
                    <path d="M3 12h12m-4-4 4 4-4 4" />
                </svg>
                @if (!MenuRecolhido) { <span>Entrar</span> }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="aluno">
                <svg class="nav-menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M2 7.5 12 3l10 4.5L12 12 2 7.5Zm4 2.1v4.1c0 1.5 2.7 3.3 6 3.3s6-1.8 6-3.3V9.6l-6 2.7-6-2.7Zm13-1.1v5h1v-5l-1-.5Z" />
                    <circle cx="12" cy="14.5" r="2.2" />
                    <path d="M7 21c.2-2.6 2.2-4.2 5-4.2s4.8 1.6 5 4.2H7Z" />
                </svg>
                @if (!MenuRecolhido) { <span>Aluno</span> }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="professores">
                <svg class="nav-menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M3 3h18v12H3V3Zm1.5 1.5v9h15v-9h-15ZM7 21l1.6-4h1.6l-1 2.5h5.6l-1-2.5h1.6l1.6 4H7Z" />
                    <circle cx="7.3" cy="10.2" r="1.5" />
                    <path d="M5.2 13c.2-1.2 1-1.8 2.1-1.8.5 0 1 .2 1.3.5L7.2 13H5.2Zm6-4.1h7.3v1.2h-7.3V8.9Zm0 2.5h5.2v1.2h-5.2v-1.2Z" />
                </svg>
                @if (!MenuRecolhido) { <span>Professores</span> }
            </NavLink>
        </div>
        @if (AuthTokens.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="minhas-aulas">
                    <svg class="nav-menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3.5" y="5.5" width="17" height="15" rx="2" />
                        <path d="M7.5 3.5v4m9-4v4M3.5 9.5h17M8 14l2.5 2.5L16 11" />
                    </svg>
                    @if (!MenuRecolhido) { <span>Minhas aulas</span> }
                </NavLink>
            </div>
        }
        @if (AuthTokens.IsStudent)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="agendar-aula">
                    <svg class="nav-menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3.5" y="5.5" width="17" height="15" rx="2" />
                        <path d="M7.5 3.5v4m9-4v4M3.5 9.5h17M12 12.5v5m-2.5-2.5h5" />
                    </svg>
                    @if (!MenuRecolhido) { <span>Agendar aula</span> }
                </NavLink>
            </div>
        }
        @if (AuthTokens.IsTeacher)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="minha-agenda">
                    <svg class="nav-menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3.5" y="5.5" width="17" height="15" rx="2" />
                        <path d="M7.5 3.5v4m9-4v4M3.5 9.5h17" />
                        <circle cx="12" cy="15" r="3" />
                        <path d="M12 13.5V15l1 1" />
                    </svg>
                    @if (!MenuRecolhido) { <span>Disponibilidade</span> }
                </NavLink>
            </div>
        }
        @if (AuthTokens.IsManager)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="gerenciar/pacotes-pontos">
                    <svg class="nav-menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="7" />
                        <circle cx="12" cy="12" r="2.5" />
                        <path d="M12 2.5v2m0 15v2m9.5-9.5h-2m-15 0h-2m16.2-6.7-1.4 1.4m-10.6 10.6-1.4 1.4m13.4 0-1.4-1.4M6.7 6.7 5.3 5.3" />
                    </svg>
                    @if (!MenuRecolhido) { <span>Gerenciar</span> }
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="gerenciar/pontos">
                    <svg class="nav-menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <ellipse cx="12" cy="6" rx="7.5" ry="3" />
                        <path d="M4.5 6v5c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3V6m-15 5v5c0 1.7 3.4 3 7.5 3 1.2 0 2.3-.1 3.3-.3" />
                        <path d="M15.5 17.5h4m-2-2v4" />
                    </svg>
                    @if (!MenuRecolhido) { <span>Gerenciar pontos</span> }
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    [Inject]
    private professor.Services.AuthTokenService AuthTokens { get; set; } = null!;

    [Parameter]
    public bool MenuRecolhido { get; set; }

    [Parameter]
    public EventCallback<bool> MenuRecolhidoChanged { get; set; }

    private bool collapseNavMenu = true;

    protected override void OnInitialized()
    {
        AuthTokens.AuthenticationStateChanged += AtualizarAutenticacao;
    }

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private Task ToggleSidebar() => MenuRecolhidoChanged.InvokeAsync(!MenuRecolhido);

    private void AtualizarAutenticacao() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AuthTokens.AuthenticationStateChanged -= AtualizarAutenticacao;
    }
}
