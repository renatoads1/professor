@page "/aluno"
@using professor.Model

<Titulo Texto="Cadastro de alunos" />

<div class="container mt-4">
    <h1 class="mb-4">Cadastro de alunos</h1>

    <EditForm Model="_alunoEmEdicao" OnValidSubmit="SalvarAluno" class="card card-body mb-4">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h2 class="h4">@(_idEmEdicao.HasValue ? "Editar aluno" : "Novo aluno")</h2>

        <div class="row g-3">
            <div class="col-md-4">
                <label for="nome" class="form-label">Nome</label>
                <InputText id="nome" class="form-control" @bind-Value="_alunoEmEdicao.Nome" />
                <ValidationMessage For="@(() => _alunoEmEdicao.Nome)" />
            </div>
            <div class="col-md-4">
                <label for="email" class="form-label">E-mail</label>
                <InputText id="email" type="email" class="form-control" @bind-Value="_alunoEmEdicao.Email" />
                <ValidationMessage For="@(() => _alunoEmEdicao.Email)" />
            </div>
            <div class="col-md-4">
                <label for="telefone" class="form-label">Telefone</label>
                <InputText id="telefone" type="tel" class="form-control" @bind-Value="_alunoEmEdicao.Telefone" />
                <ValidationMessage For="@(() => _alunoEmEdicao.Telefone)" />
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                @(_idEmEdicao.HasValue ? "Salvar alterações" : "Cadastrar aluno")
            </button>
            @if (_idEmEdicao.HasValue)
            {
                <button type="button" class="btn btn-secondary ms-2" @onclick="CancelarEdicao">Cancelar</button>
            }
        </div>
    </EditForm>

    <h2 class="h4">Alunos cadastrados</h2>
    @if (_alunos.Count == 0)
    {
        <p>Nenhum aluno cadastrado.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Telefone</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var aluno in _alunos)
                    {
                        <tr>
                            <td>@aluno.Nome</td>
                            <td>@aluno.Email</td>
                            <td>@aluno.Telefone</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditarAluno(aluno)">
                                    Editar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private readonly List<Alunos> _alunos = [];
    private Alunos _alunoEmEdicao = new();
    private int? _idEmEdicao;
    private int _proximoId = 1;

    private void SalvarAluno()
    {
        if (_idEmEdicao.HasValue)
        {
            var indice = _alunos.FindIndex(aluno => aluno.Id == _idEmEdicao.Value);
            if (indice >= 0)
            {
                _alunos[indice] = _alunoEmEdicao;
            }
        }
        else
        {
            _alunoEmEdicao.Id = _proximoId++;
            _alunos.Add(_alunoEmEdicao);
        }

        CancelarEdicao();
    }

    private void EditarAluno(Alunos aluno)
    {
        _idEmEdicao = aluno.Id;
        _alunoEmEdicao = new Alunos
        {
            Id = aluno.Id,
            Nome = aluno.Nome,
            Email = aluno.Email,
            Telefone = aluno.Telefone
        };
    }

    private void CancelarEdicao()
    {
        _idEmEdicao = null;
        _alunoEmEdicao = new Alunos();
    }
}
