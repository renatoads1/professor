@page "/professores"
@using ProfessorModel = professor.Model.Professores
@inject HttpClient Http
@inject IConfiguration Configuration
@inject IJSRuntime JS

<Titulo Texto="Cadastro de professores" />

<div class="container mt-4">
    <h1 class="mb-4">Cadastro de professores</h1>

    @if (_erro is not null)
    {
        <div class="alert alert-danger" role="alert">@_erro</div>
    }
    @if (_mensagem is not null)
    {
        <div class="alert alert-success alert-dismissible d-flex justify-content-between align-items-center" role="status">
            <span>@_mensagem</span>
            <button type="button" class="btn-close ms-3" aria-label="Fechar" @onclick="FecharMensagem"></button>
        </div>
    }

    <div class="card card-body mb-4">
        <h2 class="h4">@(_idEmEdicao.HasValue ? "Editar professor" : "Novo professor")</h2>
        <EditForm Model="_professorEmEdicao" OnValidSubmit="SalvarProfessorAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-4">
                    <label for="nome-professor" class="form-label">Nome</label>
                    <InputText id="nome-professor" class="form-control" @bind-Value="_professorEmEdicao.Nome" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Nome)" />
                </div>
                <div class="col-md-4">
                    <label for="email-professor" class="form-label">E-mail</label>
                    <InputText id="email-professor" type="email" class="form-control" @bind-Value="_professorEmEdicao.Email" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Email)" />
                </div>
                <div class="col-md-4">
                    <label for="telefone-professor" class="form-label">Telefone</label>
                    <InputText id="telefone-professor" type="tel" class="form-control" @bind-Value="_professorEmEdicao.Telefone" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Telefone)" />
                </div>
                <div class="col-md-4">
                    <label for="pais-professor" class="form-label">País</label>
                    <InputText id="pais-professor" class="form-control" @bind-Value="_professorEmEdicao.Pais" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Pais)" />
                </div>
                <div class="col-md-4">
                    <label for="estado-professor" class="form-label">Estado</label>
                    <InputText id="estado-professor" class="form-control" @bind-Value="_professorEmEdicao.Estado" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Estado)" />
                </div>
                <div class="col-md-4">
                    <label for="cidade-professor" class="form-label">Cidade</label>
                    <InputText id="cidade-professor" class="form-control" @bind-Value="_professorEmEdicao.Cidade" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Cidade)" />
                </div>
                <div class="col-md-4">
                    <label for="lingua-professor" class="form-label">Idioma que ensina</label>
                    <InputText id="lingua-professor" class="form-control" @bind-Value="_professorEmEdicao.LinguaDeEnsino" />
                    <ValidationMessage For="@(() => _professorEmEdicao.LinguaDeEnsino)" />
                </div>
                <div class="col-md-8">
                    <label for="apresentacao-professor" class="form-label">Apresentação</label>
                    <InputTextArea id="apresentacao-professor" class="form-control" rows="3" @bind-Value="_professorEmEdicao.Apresentacao" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Apresentacao)" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <InputCheckbox id="ativo-professor" class="form-check-input" @bind-Value="_professorEmEdicao.Ativo" />
                        <label for="ativo-professor" class="form-check-label">Perfil ativo</label>
                    </div>
                </div>
            </div>

            @if (!_idEmEdicao.HasValue)
            {
                <div class="mt-3">
                    <TurnstileCaptcha @ref="_turnstileCaptcha"
                                      SiteKey="@TurnstileSiteKey"
                                      Action="cadastro_professor"
                                      OnTokenChanged="AtualizarTokenAsync" />
                </div>
            }

            <div class="mt-3">
                <button type="submit" class="btn btn-primary" disabled="@(_salvando || (!_idEmEdicao.HasValue && string.IsNullOrWhiteSpace(_turnstileToken)))">
                    @(_idEmEdicao.HasValue ? "Salvar alterações" : "Cadastrar professor")
                </button>
                @if (_idEmEdicao.HasValue)
                {
                    <button type="button" class="btn btn-secondary ms-2" @onclick="CancelarEdicao">Cancelar</button>
                }
            </div>
        </EditForm>
    </div>

    <h2 class="h4">Professores cadastrados</h2>
    @if (_carregando)
    {
        <p>Carregando professores...</p>
    }
    else if (_professores.Count == 0)
    {
        <p>Nenhum professor cadastrado.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Telefone</th>
                        <th>Localização</th>
                        <th>Idioma</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var professor in _professores)
                    {
                        <tr>
                            <td>@professor.Nome</td>
                            <td>@professor.Email</td>
                            <td>@professor.Telefone</td>
                            <td>@professor.Cidade, @professor.Estado, @professor.Pais</td>
                            <td>@professor.LinguaDeEnsino</td>
                            <td>@(professor.Ativo ? "Ativo" : "Inativo")</td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => EditarProfessor(professor)">Editar</button>
                                <button type="button" class="btn btn-sm btn-outline-danger ms-1" disabled="@_excluindo" @onclick="() => ExcluirProfessorAsync(professor)">Excluir</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<ProfessorModel> _professores = [];
    private ProfessorModel _professorEmEdicao = new();
    private int? _idEmEdicao;
    private bool _carregando = true;
    private bool _salvando;
    private bool _excluindo;
    private string _turnstileToken = string.Empty;
    private string? _erro;
    private string? _mensagem;
    private TurnstileCaptcha? _turnstileCaptcha;

    private string TurnstileSiteKey => Configuration["CloudflareTurnstile:SiteKey"] ?? string.Empty;

    protected override Task OnInitializedAsync() => CarregarProfessoresAsync();

    private async Task CarregarProfessoresAsync()
    {
        _carregando = true;
        _erro = null;

        try
        {
            _professores = await Http.GetFromJsonAsync<List<ProfessorModel>>("api/Professores") ?? [];
        }
        catch (HttpRequestException)
        {
            _erro = "Não foi possível carregar os professores. Verifique se a API está em execução.";
        }
        finally
        {
            _carregando = false;
        }
    }

    private async Task SalvarProfessorAsync()
    {
        _erro = null;
        _mensagem = null;
        var criandoProfessor = !_idEmEdicao.HasValue;
        if (criandoProfessor && string.IsNullOrWhiteSpace(_turnstileToken))
        {
            _erro = "Conclua a validação CAPTCHA antes de cadastrar o professor.";
            return;
        }

        _salvando = true;
        try
        {
            using var resposta = criandoProfessor
                ? await Http.PostAsJsonAsync("api/Professores", new
                {
                    Professor = _professorEmEdicao,
                    TurnstileToken = _turnstileToken
                })
                : await Http.PutAsJsonAsync($"api/Professores/{_professorEmEdicao.Id}", _professorEmEdicao);

            if (!resposta.IsSuccessStatusCode)
            {
                _erro = resposta.StatusCode switch
                {
                    System.Net.HttpStatusCode.BadRequest => "A validação CAPTCHA falhou ou expirou. Faça o desafio novamente.",
                    System.Net.HttpStatusCode.Conflict => "Já existe um professor cadastrado com este e-mail.",
                    _ => $"A API retornou o status {(int)resposta.StatusCode} ao salvar o professor."
                };
                return;
            }

            _mensagem = criandoProfessor ? "Professor cadastrado com sucesso." : "Professor atualizado com sucesso.";
            CancelarEdicao();
            await CarregarProfessoresAsync();
        }
        catch (HttpRequestException)
        {
            _erro = "Não foi possível salvar o professor. Verifique se a API está em execução.";
        }
        finally
        {
            if (criandoProfessor && _turnstileCaptcha is not null)
            {
                try
                {
                    await _turnstileCaptcha.ResetAsync();
                }
                catch (JSException)
                {
                    _turnstileToken = string.Empty;
                }
            }

            _salvando = false;
        }
    }

    private void EditarProfessor(ProfessorModel professor)
    {
        _erro = null;
        _mensagem = null;
        _idEmEdicao = professor.Id;
        _professorEmEdicao = new ProfessorModel
        {
            Id = professor.Id,
            Nome = professor.Nome,
            Email = professor.Email,
            Telefone = professor.Telefone,
            Pais = professor.Pais,
            Estado = professor.Estado,
            Cidade = professor.Cidade,
            LinguaDeEnsino = professor.LinguaDeEnsino,
            Apresentacao = professor.Apresentacao,
            Ativo = professor.Ativo
        };
    }

    private async Task ExcluirProfessorAsync(ProfessorModel professor)
    {
        var confirmar = await JS.InvokeAsync<bool>("confirm", $"Deseja excluir o professor {professor.Nome}?");
        if (!confirmar)
        {
            return;
        }

        _erro = null;
        _mensagem = null;
        _excluindo = true;
        try
        {
            using var resposta = await Http.DeleteAsync($"api/Professores/{professor.Id}");
            if (!resposta.IsSuccessStatusCode)
            {
                _erro = $"A API retornou o status {(int)resposta.StatusCode} ao excluir o professor.";
                return;
            }

            _mensagem = "Professor excluído com sucesso.";
            await CarregarProfessoresAsync();
        }
        catch (HttpRequestException)
        {
            _erro = "Não foi possível excluir o professor. Verifique se a API está em execução.";
        }
        finally
        {
            _excluindo = false;
        }
    }

    private Task AtualizarTokenAsync(string token)
    {
        _turnstileToken = token;
        return Task.CompletedTask;
    }

    private void CancelarEdicao()
    {
        _idEmEdicao = null;
        _professorEmEdicao = new ProfessorModel();
    }

    private void FecharMensagem() => _mensagem = null;
}
