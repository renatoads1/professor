@page "/professores"
@using ProfessorModel = professor.Model.Professores
@inject HttpClient Http

<Titulo Texto="Cadastro de professores" />

<div class="container mt-4">

    @if (_erro is not null)
    {
        <div class="alert alert-danger" role="alert">@_erro</div>
    }
    @if (_mensagem is not null)
    {
        <div class="alert alert-success alert-dismissible d-flex justify-content-between align-items-center" role="status">
            <span>@_mensagem</span>
            <button type="button" class="btn-close ms-3" aria-label="Fechar" @onclick="FecharMensagem"></button>
        </div>
    }

    <div class="accordion mb-4" id="acordeao-formulario-professor">
        <div class="accordion-item">
            <h2 class="accordion-header" id="cabecalho-formulario-professor">
                <button type="button"
                        class="@(_formularioAberto ? "accordion-button" : "accordion-button collapsed")"
                        aria-expanded="@_formularioAberto"
                        aria-controls="conteudo-formulario-professor"
                        @onclick="AlternarFormulario">
                    @(_idEmEdicao.HasValue ? "Editar professor" : "Novo professor")
                </button>
            </h2>
            <div id="conteudo-formulario-professor"
                 class="@(_formularioAberto ? "accordion-collapse collapse show" : "accordion-collapse collapse")"
                 aria-labelledby="cabecalho-formulario-professor">
                <EditForm Model="_professorEmEdicao" OnValidSubmit="SalvarProfessorAsync" class="accordion-body">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">
                <div class="col-md-4">
                    <label for="nome-professor" class="form-label">Nome</label>
                    <InputText id="nome-professor" class="form-control" @bind-Value="_professorEmEdicao.Nome" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Nome)" />
                </div>
                <div class="col-md-4">
                    <label for="email-professor" class="form-label">E-mail (login)</label>
                    <InputText id="email-professor" type="email" class="form-control" @bind-Value="_professorEmEdicao.Email" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Email)" />
                </div>
                @if (!_idEmEdicao.HasValue)
                {
                    <div class="col-md-4">
                        <label for="senha-professor" class="form-label">Senha (mínimo 8 caracteres)</label>
                        <InputText id="senha-professor" type="password" class="form-control" autocomplete="new-password" @bind-Value="_senhaCadastro" />
                    </div>
                    <div class="col-md-4">
                        <label for="foto-perfil-professor" class="form-label">Foto de perfil (JPEG, PNG ou WebP; até 2 MiB)</label>
                        <InputFile id="foto-perfil-professor" class="form-control" accept="image/jpeg,image/png,image/webp" OnChange="SelecionarFotoPerfilAsync" />
                    </div>
                    @if (_fotoPreviewUrl is not null)
                    {
                        <div class="col-md-4">
                            <img src="@_fotoPreviewUrl" alt="Prévia da foto de perfil" class="img-thumbnail" style="max-height: 180px; object-fit: cover;" />
                        </div>
                    }
                }
                <div class="col-md-4">
                    <label for="telefone-professor" class="form-label">Telefone</label>
                    <input id="telefone-professor" type="tel" class="form-control" data-phone-mask="br" @bind="_professorEmEdicao.Telefone" @bind:event="oninput" />
                </div>
                <div class="col-md-4">
                    <label for="pais-professor" class="form-label">País</label>
                    <InputText id="pais-professor" class="form-control" @bind-Value="_professorEmEdicao.Pais" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Pais)" />
                </div>
                <div class="col-md-4">
                    <label for="estado-professor" class="form-label">Estado</label>
                    <InputText id="estado-professor" class="form-control" @bind-Value="_professorEmEdicao.Estado" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Estado)" />
                </div>
                <div class="col-md-4">
                    <label for="cidade-professor" class="form-label">Cidade</label>
                    <InputText id="cidade-professor" class="form-control" @bind-Value="_professorEmEdicao.Cidade" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Cidade)" />
                </div>
                <div class="col-md-4">
                    <label for="lingua-professor" class="form-label">Idioma que ensina</label>
                    <InputText id="lingua-professor" class="form-control" @bind-Value="_professorEmEdicao.LinguaDeEnsino" />
                    <ValidationMessage For="@(() => _professorEmEdicao.LinguaDeEnsino)" />
                </div>
                <div class="col-md-4">
                    <label for="hora-aula-professor" class="form-label">Valor da hora-aula</label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input id="hora-aula-professor" class="form-control" inputmode="decimal" placeholder="0,00"
                               value="@_horaAulaTexto" @oninput="AtualizarHoraAula" @onblur="FormatarHoraAula" />
                    </div>
                    <ValidationMessage For="@(() => _professorEmEdicao.HoraAula)" />
                </div>
                <div class="col-md-8">
                    <label for="apresentacao-professor" class="form-label">Apresentação</label>
                    <InputTextArea id="apresentacao-professor" class="form-control" rows="3" @bind-Value="_professorEmEdicao.Apresentacao" />
                    <ValidationMessage For="@(() => _professorEmEdicao.Apresentacao)" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <InputCheckbox id="ativo-professor" class="form-check-input" @bind-Value="_professorEmEdicao.Ativo" />
                        <label for="ativo-professor" class="form-check-label">Perfil ativo</label>
                    </div>
                </div>
                @if (!_idEmEdicao.HasValue)
                {
                    <div class="col-12">
                        <div class="form-check">
                            <InputCheckbox id="termos-professor" class="form-check-input" @bind-Value="_professorEmEdicao.TermosAceitos" />
                            <label for="termos-professor" class="form-check-label">Li e aceito os termos de uso e compartilhamento de dados.</label>
                            <button type="button" class="btn btn-link btn-sm" @onclick="AbrirTermos">Ler termos</button>
                            <ValidationMessage For="@(() => _professorEmEdicao.TermosAceitos)" />
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary" disabled="@(_salvando || (!_idEmEdicao.HasValue && !_professorEmEdicao.TermosAceitos))">
                    @(_idEmEdicao.HasValue ? "Salvar alterações" : "Cadastrar professor")
                </button>
                @if (_idEmEdicao.HasValue)
                {
                    <button type="button" class="btn btn-secondary ms-2" @onclick="CancelarEdicao">Cancelar</button>
                }
            </div>
                </EditForm>
            </div>
        </div>
    </div>

    @if (_termosAbertos)
    {
        <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="termos-professor-titulo" style="background-color: rgba(0,0,0,.5);">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="termos-professor-titulo">Termos de Uso e Consentimento de Compartilhamento de Dados</h2>
                        <button type="button" class="btn-close" aria-label="Fechar" @onclick="FecharTermos"></button>
                    </div>
                    <div class="modal-body">
                        <p>Ao realizar seu cadastro neste sistema, você declara que leu, compreendeu e aceita integralmente estes termos.</p>
                        <p>Você concorda que as informações fornecidas durante o processo de registro — incluindo, mas não se limitando a nome, e-mail, telefone, endereço e demais dados pessoais inseridos voluntariamente — poderão ser armazenadas, processadas e compartilhadas na internet conforme as finalidades do serviço.</p>
                        <p>O compartilhamento dos dados poderá ocorrer para:</p>
                        <ul>
                            <li>Identificação e autenticação do usuário;</li>
                            <li>Comunicação por e-mail, telefone ou outros meios digitais;</li>
                            <li>Integração com serviços externos necessários ao funcionamento da plataforma;</li>
                            <li>Cumprimento de obrigações legais ou regulatórias.</li>
                        </ul>
                        <p>Ao prosseguir com o cadastro, você autoriza expressamente o uso e a divulgação dessas informações dentro dos limites previstos nestes termos. Caso não concorde, não deverá concluir o registro ou utilizar o sistema.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="FecharTermos">Fechar</button>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private static readonly System.Globalization.CultureInfo _culturaBrasileira =
        System.Globalization.CultureInfo.GetCultureInfo("pt-BR");

    private ProfessorModel _professorEmEdicao = new();
    private string _horaAulaTexto = string.Empty;
    private bool _formularioAberto;
    private bool _filtrosAbertos;
    private int? _idEmEdicao;
    private bool _salvando;
    private bool _termosAbertos;
    private string _senhaCadastro = string.Empty;
    private const long MaxFotoPerfilBytes = 2 * 1024 * 1024;
    private byte[]? _fotoPerfil;
    private string? _fotoPerfilContentType;
    private string? _fotoPreviewUrl;
    private string? _erro;
    private string? _mensagem;
    private string _filtroNome = string.Empty;
    private string _filtroId = string.Empty;
    private string _filtroEmail = string.Empty;
    private string _filtroTelefone = string.Empty;
    private string _filtroPais = string.Empty;
    private string _filtroEstado = string.Empty;
    private string _filtroCidade = string.Empty;
    private string _filtroLingua = string.Empty;
    private string _filtroApresentacao = string.Empty;
    private string _filtroPrecoMinimoTexto = string.Empty;
    private string _filtroPrecoMaximoTexto = string.Empty;
    private string _filtroAtivo = string.Empty;

    private static bool Corresponde(string valor, string filtro) =>
        string.IsNullOrWhiteSpace(filtro)
        || valor.Contains(filtro.Trim(), StringComparison.OrdinalIgnoreCase);

    private static bool TentarLerPreco(string texto, out decimal preco)
    {
        if (string.IsNullOrWhiteSpace(texto))
        {
            preco = 0m;
            return false;
        }

        return decimal.TryParse(texto, System.Globalization.NumberStyles.Currency,
                   _culturaBrasileira, out preco)
            || decimal.TryParse(texto, System.Globalization.NumberStyles.Number,
                   System.Globalization.CultureInfo.InvariantCulture, out preco);
    }

    protected override Task OnInitializedAsync() => Task.CompletedTask;

    private async Task SalvarProfessorAsync()
    {
        _erro = null;
        _mensagem = null;
        var criandoProfessor = !_idEmEdicao.HasValue;
        if (criandoProfessor && !_professorEmEdicao.TermosAceitos)
        {
            _erro = "É necessário aceitar os termos para cadastrar o professor.";
            return;
        }

        _salvando = true;
        try
        {
            using var resposta = criandoProfessor
                ? await Http.PostAsJsonAsync("api/Professores", new
                {
                    Professor = _professorEmEdicao,
                    Senha = _senhaCadastro,
                    FotoPerfil = _fotoPerfil,
                    FotoPerfilContentType = _fotoPerfilContentType
                })
                : await Http.PutAsJsonAsync($"api/Professores/{_professorEmEdicao.Id}", _professorEmEdicao);

            if (!resposta.IsSuccessStatusCode)
            {
                if (resposta.StatusCode == System.Net.HttpStatusCode.BadRequest)
                {
                    var erroApi = await resposta.Content.ReadFromJsonAsync<ApiError>();
                    _erro = erroApi?.Message ?? "Revise os dados do cadastro e tente novamente.";
                }
                else if (resposta.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    _erro = "Já existe um professor cadastrado com este e-mail.";
                }
                else
                {
                    _erro = $"A API retornou o status {(int)resposta.StatusCode} ao salvar o professor.";
                }

                return;
            }

            _mensagem = criandoProfessor ? "Professor cadastrado com sucesso." : "Professor atualizado com sucesso.";
            CancelarEdicao();
            _senhaCadastro = string.Empty;
            _formularioAberto = false;
        }
        catch (HttpRequestException)
        {
            _erro = "Não foi possível salvar o professor. Verifique se a API está em execução.";
        }
        finally
        {
            _salvando = false;
        }
    }

    private void EditarProfessor(ProfessorModel professor)
    {
        _erro = null;
        _mensagem = null;
        _idEmEdicao = professor.Id;
        _professorEmEdicao = new ProfessorModel
        {
            Id = professor.Id,
            Nome = professor.Nome,
            Email = professor.Email,
            Telefone = professor.Telefone,
            Pais = professor.Pais,
            Estado = professor.Estado,
            Cidade = professor.Cidade,
            LinguaDeEnsino = professor.LinguaDeEnsino,
            HoraAula = professor.HoraAula,
            Apresentacao = professor.Apresentacao,
            Ativo = professor.Ativo
        };
        _horaAulaTexto = professor.HoraAula.ToString("N2", _culturaBrasileira);
    }

    private void AtualizarHoraAula(ChangeEventArgs args)
    {
        var digitos = new string((args.Value?.ToString() ?? string.Empty).Where(char.IsDigit).ToArray());
        if (digitos.Length > 8)
        {
            digitos = digitos[..8];
        }

        if (long.TryParse(digitos, out var centavos))
        {
            _professorEmEdicao.HoraAula = centavos / 100m;
            _horaAulaTexto = _professorEmEdicao.HoraAula.ToString("N2", _culturaBrasileira);
        }
        else
        {
            _professorEmEdicao.HoraAula = 0m;
            _horaAulaTexto = string.Empty;
        }
    }

    private void FormatarHoraAula(FocusEventArgs args)
    {
        _horaAulaTexto = _professorEmEdicao.HoraAula > 0
            ? _professorEmEdicao.HoraAula.ToString("N2", _culturaBrasileira)
            : string.Empty;
    }

    private async Task SelecionarFotoPerfilAsync(InputFileChangeEventArgs args)
    {
        _erro = null;
        _fotoPerfil = null;
        _fotoPerfilContentType = null;
        _fotoPreviewUrl = null;

        var arquivo = args.File;
        if (arquivo.Size is 0 or > MaxFotoPerfilBytes
            || arquivo.ContentType is not ("image/jpeg" or "image/png" or "image/webp"))
        {
            _erro = "Selecione uma foto JPEG, PNG ou WebP de até 2 MiB.";
            return;
        }

        try
        {
            await using var stream = arquivo.OpenReadStream(MaxFotoPerfilBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _fotoPerfil = buffer.ToArray();
            _fotoPerfilContentType = arquivo.ContentType;
            _fotoPreviewUrl = $"data:{arquivo.ContentType};base64,{Convert.ToBase64String(_fotoPerfil)}";
        }
        catch (IOException)
        {
            _erro = "A foto não pode exceder 2 MiB.";
        }
    }

    private void AbrirTermos() => _termosAbertos = true;

    private void FecharTermos() => _termosAbertos = false;

    private void AlternarFormulario() => _formularioAberto = !_formularioAberto;

    private void AlternarFiltros() => _filtrosAbertos = !_filtrosAbertos;

    private void LimparFiltros()
    {
        _filtroId = string.Empty;
        _filtroNome = string.Empty;
        _filtroEmail = string.Empty;
        _filtroTelefone = string.Empty;
        _filtroPais = string.Empty;
        _filtroEstado = string.Empty;
        _filtroCidade = string.Empty;
        _filtroLingua = string.Empty;
        _filtroApresentacao = string.Empty;
        _filtroPrecoMinimoTexto = string.Empty;
        _filtroPrecoMaximoTexto = string.Empty;
        _filtroAtivo = string.Empty;
    }

    private void CancelarEdicao()
    {
        _idEmEdicao = null;
        _professorEmEdicao = new ProfessorModel();
        _horaAulaTexto = string.Empty;
        _senhaCadastro = string.Empty;
        _fotoPerfil = null;
        _fotoPerfilContentType = null;
        _fotoPreviewUrl = null;
    }

    private void FecharMensagem() => _mensagem = null;

    private sealed record ApiError(string? Message);
}
